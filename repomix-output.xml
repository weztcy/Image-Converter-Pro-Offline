"""
Conversion Background Worker
"""

from PySide6.QtCore import (
    QThread,
    Signal
)

from core.batch_processor import BatchProcessor



class ConversionWorker(QThread):

    progress = Signal(
        int,
        int
    )

    finished = Signal(
        dict
    )


    def __init__(
        self,
        files,
        output,
        format
    ):

        super().__init__()

        self.files = files
        self.output = output
        self.format = format



    def run(self):

        processor = BatchProcessor()


        total = len(
            self.files
        )


        completed = 0


        for file in self.files:


            result = processor.process_files(
                [file],
                self.output,
                self.format
            )


            completed += 1


            self.progress.emit(
                completed,
                total
            )


        self.finished.emit(
            processor.results
        )
