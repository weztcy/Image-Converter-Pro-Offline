from core.batch_processor import BatchProcessor

from .progress_widget import ProgressWidget
from .conversion_worker import ConversionWorker



class BatchPage(QWidget):

    def __init__(self):

        super().__init__()

        self.worker = None

        self.files = []

        self.output_folder = None

        self.setup_ui()



    def setup_ui(self):

        layout = QVBoxLayout()


        self.file_label = QLabel(
            "No files selected"
        )


        self.select_button = QPushButton(
            "Select Images"
        )


        self.folder_button = QPushButton(
            "Select Folder"
        )


        self.format_box = QComboBox()

        self.format_box.addItems(
            [
                "JPG",
                "PNG",
                "WEBP"
            ]
        )


        self.output_button = QPushButton(
            "Select Output Folder"
        )


        self.convert_button = QPushButton(
            "Start Batch Convert"
        )


        self.status_label = QLabel(
            "Waiting..."
        )


        self.progress_widget = ProgressWidget()



        widgets = [
            self.file_label,
            self.select_button,
            self.folder_button,
            self.format_box,
            self.output_button,
            self.convert_button,
            self.progress_widget,
            self.status_label
        ]


        for widget in widgets:

            layout.addWidget(
                widget
            )


        self.setLayout(
            layout
        )


        self.select_button.clicked.connect(
            self.select_files
        )


        self.folder_button.clicked.connect(
            self.select_folder
        )


        self.output_button.clicked.connect(
            self.select_output_folder
        )


        self.convert_button.clicked.connect(
            self.convert
        )



    def select_files(self):

        files, _ = QFileDialog.getOpenFileNames(
            self,
            "Select Images",
            "",
            "Images (*.jpg *.jpeg *.png *.webp *.heic *.heif)"
        )


        self.files = [
            Path(file)
            for file in files
        ]


        self.file_label.setText(
            f"{len(self.files)} files selected"
        )



    def select_folder(self):

        folder = QFileDialog.getExistingDirectory(
            self,
            "Select Folder"
        )


        if folder:

            processor = BatchProcessor()


            self.files = (
                processor.get_images_from_folder(
                    folder
                )
            )


            self.file_label.setText(
                f"{len(self.files)} files found"
            )



    def select_output_folder(self):

        folder = QFileDialog.getExistingDirectory(
            self,
            "Select Output Folder"
        )


        if folder:

            self.output_folder = Path(folder)


            self.status_label.setText(
                f"Output: {folder}"
            )



    def convert(self):

        if not self.files:

            self.status_label.setText(
                "No files selected"
            )

            return


        if not self.output_folder:

            self.output_folder = (
                self.files[0].parent
                /
                "batch_output"
            )


        self.status_label.setText(
            "Processing..."
        )


        self.worker = ConversionWorker(
            self.files,
            self.output_folder,
            self.format_box.currentText()
        )


        self.worker.progress.connect(
            self.progress_widget.update_progress
        )


        self.worker.finished.connect(
            self.finished_process
        )


        self.worker.start()



    def finished_process(
        self,
        result
    ):

        success = len(
            result["success"]
        )


        failed = len(
            result["failed"]
        )


        self.status_label.setText(
            f"Finished | Success: {success} | Failed: {failed}"
        )
